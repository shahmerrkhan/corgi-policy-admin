# Names only. Copy to .env.local and fill in. Never commit real values.

# Public origin for absolute URLs (Stripe return URLs), e.g. https://<project>.vercel.app
# Optional: falls back to the Vercel URL, then http://localhost:3000 outside production.
APP_URL=

# Neon Postgres
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (optional: without a key, emails are logged as skipped)
RESEND_API_KEY=
# Comma-separated recipient allowlist; unset means delivered@resend.dev
RESEND_ALLOWED_TO=
